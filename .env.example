# ADAN Trading Bot - Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================================
# NIVEAU 1: Async WebSocket Engine
# ============================================================================
# Exchange API (Binance/Bitget)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here
BINANCE_TESTNET=true

# Binance Testnet (optional, for paper trading on testnet)
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# ============================================================================
# NIVEAU 2: Zero-Trust Security
# ============================================================================
# Separate read-only and trade-only credentials (recommended)
ADAN_API_READ_ONLY=your_read_only_key_here
ADAN_API_TRADE_ONLY=your_trade_only_key_here

# ============================================================================
# NIVEAU 3: Streamlit Dashboard
# ============================================================================
# Dashboard runs on port 8501 (configured in docker-compose.yml)
STREAMLIT_SERVER_PORT=8501

# ============================================================================
# NIVEAU 4: Telegram/Discord Alerts
# ============================================================================
# Telegram Bot Configuration
ADAN_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADAN_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook Configuration
ADAN_DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================================================
# Trading Parameters
# ============================================================================
TRADING_PAIR=BTC/USDT
INITIAL_BALANCE=25

# Dataset generation
ADAN_CANDLES=5000

# ============================================================================
# NIVEAU 5: Docker Containerization
# ============================================================================
# These are automatically set in docker-compose.yml
# No additional configuration needed

